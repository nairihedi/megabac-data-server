<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modèle IIS pour le DOSSIER DES DONNÉES (celui lu par l'application MegaBac).
  À placer à la racine des données (à côté de 6/, 5/, …) ou à fusionner avec le web.config existant.

  - Cache-Control: no-cache : le navigateur REVALIDE à chaque requête (réponse 304 si le fichier n'a
    pas changé, donc très léger). Sans cela, IIS ne donne aucune consigne et le navigateur garde
    version.json en cache « heuristique » : l'application ne voit alors pas qu'un cours a été modifié.
  - CORS : nécessaire si l'application et les données sont sur des origines différentes.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- remove avant add : évite l'erreur 500.19 « entrée dupliquée » quand ce dossier
             est une sous-application d'un site dont le web.config déclare déjà ces en-têtes. -->
        <remove name="Access-Control-Allow-Origin" />
        <remove name="Access-Control-Allow-Methods" />
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS, HEAD" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
        <security>
            <requestFiltering>
                <fileExtensions>
                    <add fileExtension=".json" allowed="true" />
                </fileExtensions>
            </requestFiltering>
        </security>
  </system.webServer>
</configuration>
